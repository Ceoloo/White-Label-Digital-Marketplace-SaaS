# =============================================================================
# White-Label Digital Marketplace — Environment Configuration
# =============================================================================
# Copy this file to `.env.local` and fill in the values you need.
# The app runs fully with the built-in in-memory demo data when these are
# left blank, so you can develop and demo without any external accounts.
# =============================================================================

# ---- Data layer (Airtable) --------------------------------------------------
# When both are set, the app reads/writes the Airtable base instead of the
# built-in in-memory demo store.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Optional: override the default table names if your base uses different ones.
AIRTABLE_TABLE_USERS=Users
AIRTABLE_TABLE_PRODUCTS=Products
AIRTABLE_TABLE_ORDERS=Orders
AIRTABLE_TABLE_COUPONS=Coupons
AIRTABLE_TABLE_REWARDS=Rewards
AIRTABLE_TABLE_AI_SERVICES=AI Services
AIRTABLE_TABLE_AUDIT_LOGS=Audit Logs

# ---- Payments: Stripe -------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Payments: Crypto gateway ----------------------------------------------
# Wallet addresses shown to buyers for manual/verified crypto payments.
CRYPTO_WALLET_BTC=
CRYPTO_WALLET_ETH=
CRYPTO_WALLET_USDC=
CRYPTO_WALLET_USDT=

# ---- Payments: Zelle (manual confirmation workflow) ------------------------
ZELLE_RECIPIENT_NAME=
ZELLE_RECIPIENT_EMAIL=
ZELLE_RECIPIENT_PHONE=

# ---- Privacy Suite: approved egress providers ------------------------------
# The app does NOT bundle a VPN or Tor client. To route the app's own
# server-side outbound requests through an approved egress, point one of these
# at an endpoint YOU operate and are authorized to use, then enable the matching
# provider in config/marketplace.config.ts. Leave blank for direct connections.
#   - HTTP/HTTPS proxy URLs work out of the box when `undici` is installed.
#   - SOCKS/Tor URLs additionally require a SOCKS-capable dispatcher.
PRIVACY_VPN_PROXY_URL=
PRIVACY_TOR_PROXY_URL=
PRIVACY_HTTP_PROXY_URL=

# ---- App --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
